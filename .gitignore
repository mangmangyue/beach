# ══════════════════════════════════════════════
#  白名单式忽略：默认忽略一切，再逐个放行。
#  这个项目本地有 2GB（原图、渲染图、Blender 源文件），
#  用黑名单迟早会漏一个进 git 历史，之后删不掉。
# ══════════════════════════════════════════════

/*

!/.gitignore
!/index.html
!/README.md
!/共用/
!/音乐层/
!/浪声素材/
!/照片/
!/物件_贝壳/
!/物件_花/
!/物件_吉他/
!/物件_设备/
!/物件_酒/
!/标杆物件_唱机/

# ── 共用/：排除渲染图、文档、备份、后端脚本 ──
共用/渲染/
共用/*.md
共用/*.bak
共用/*.py
共用/*.json

# ── 物件文件夹：只要 viewer 里的 .glb ──────────
物件_*/*
标杆物件_唱机/*
!物件_*/viewer/
!标杆物件_唱机/viewer/
物件_*/viewer/*
标杆物件_唱机/viewer/*
!物件_*/viewer/*.glb
!标杆物件_唱机/viewer/*.glb

# ── 杂 ──
.DS_Store
**/.DS_Store

# ── 照片/ 里只有精选的成品上线，工作文件不上线 ──
照片/_缩略图/
照片/_预览图/
照片/_全部.json
照片/_精选.json
照片/选照片.html
